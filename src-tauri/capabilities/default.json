{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "permissions for the main window",
	"windows": ["main"],
	"permissions": [
		"core:path:default",
		"core:event:default",
		"core:window:default",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-destroy",
		"core:window:allow-start-dragging",
		"fs:read-all",
		"fs:write-all",
		"fs:scope-appconfig-recursive",
		{
			"identifier": "fs:scope",
			"allow": [
				{
					"path": "$DOCUMENT/vylite"
				},
				{
					"path": "$DOCUMENT/vylite/**"
				}
			]
		},
		"dialog:allow-open",
		"opener:default",
		"updater:default"
	]
}
